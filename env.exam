# ===== 节点/订阅自动上传 =====
# 部署 Merge-sub 项目后的首页地址，例如：https://merge.xxx.com
UPLOAD_URL=
# 需要上传订阅或保活时填写项目分配的 url，例如：https://google.com
PROJECT_URL=
# 自动保活开关：true 开启 / false 关闭（需同时填写 PROJECT_URL）
AUTO_ACCESS=false

# ===== 运行目录与订阅 =====
# 运行目录，sub 节点文件保存目录
FILE_PATH=.tmp
# 订阅路径（访问 /{SUB_PATH} 获取节点）
SUB_PATH=sub
# http 服务订阅端口（也可用 PORT）
SERVER_PORT=3000

# ===== 节点配置 =====
# UUID，使用哪吒 v1 在不同平台运行时需修改，否则会覆盖
UUID=9afd1229-b893-40c1-84dd-51e7ce204913
# 节点优选域名或优选 ip
CFIP=saas.sin.fan
# 节点优选域名或优选 ip 对应的端口
CFPORT=443
# 节点名称
NAME=

# ===== 哪吒探针 =====
# 哪吒 v1 形式：nz.abc.com:8008 ；哪吒 v0 形式：nz.abc.com
NEZHA_SERVER=
# 使用哪吒 v1 请留空，哪吒 v0 需填写
NEZHA_PORT=
# 哪吒 v1 的 NZ_CLIENT_SECRET 或哪吒 v0 的 agent 密钥
NEZHA_KEY=

# ===== Argo 隧道 =====
# 固定隧道域名，留空即启用临时隧道
ARGO_DOMAIN=
# 固定隧道密钥 json 或 token，留空即启用临时隧道（json 获取：https://json.zone.id）
ARGO_AUTH=
# 固定隧道端口，使用 token 需在 Cloudflare 后台设置与此一致
ARGO_PORT=8001
